{
  "name": "@metricas-dspd/e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Testes E2E e de acessibilidade do dashboard de métricas (Playwright + axe)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --project=chromium-semente-alt",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:perf": "playwright test --project=perf",
    "size": "node scripts/tamanho-bundle.mjs",
    "lighthouse": "bash scripts/lighthouse.sh",
    "hash-base": "node scripts/hash-base-mock.mjs",
    "gate": "node scripts/gate.mjs",
    "chromium:local": "bash scripts/setup-chromium-local.sh",
    "fronteiras": "node scripts/verificar-fronteiras.mjs",
    "perf:tudo": "pnpm run size && pnpm run test:perf && pnpm run lighthouse"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.1",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@playwright/test": "^1.50.0",
    "pdfjs-dist": "^6.4.299"
  }
}
