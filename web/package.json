{
  "name": "@metricas-dspd/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc -b",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "check": "pnpm run typecheck && npm test",
    "cobertura": "TZ=UTC vitest run --coverage",
    "pronto": "pnpm run typecheck && pnpm run cobertura && pnpm run build && pnpm run size"
  },
  "dependencies": {
    "@metricas-dspd/contratos": "workspace:*",
    "@metricas-dspd/metricas": "workspace:*",
    "@metricas-dspd/mock": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
