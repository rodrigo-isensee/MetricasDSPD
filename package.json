{
  "name": "metricas-dspd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @metricas-dspd/web dev",
    "build": "pnpm --filter @metricas-dspd/web build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @metricas-dspd/contratos --filter @metricas-dspd/metricas --filter @metricas-dspd/mock --filter @metricas-dspd/web --filter @metricas-dspd/server --filter @metricas-dspd/homolog run typecheck && pnpm --filter @metricas-dspd/e2e exec tsc --noEmit",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write web packages tools eslint.config.js tsconfig.base.json package.json",
    "format:check": "prettier --check web packages tools eslint.config.js tsconfig.base.json package.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run format:check",
    "pronto": "pnpm run lint && pnpm run format:check && pnpm -r --if-present run pronto",
    "cobertura": "pnpm -r --if-present run cobertura",
    "spec:check": "pnpm --filter @metricas-dspd/spec-check run spec:check",
    "docs:gerar": "pnpm --filter @metricas-dspd/docs-contratos run docs:gerar",
    "docs:check": "pnpm --filter @metricas-dspd/docs-contratos run docs:check",
    "docs:fotografar": "pnpm --filter @metricas-dspd/docs-contratos run docs:fotografar",
    "docs:mermaid": "pnpm --filter @metricas-dspd/docs-contratos run docs:mermaid",
    "e2e": "pnpm --filter @metricas-dspd/e2e test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm run db:up",
    "db:migrate": "bash scripts/db.sh migrate",
    "db:seed": "bash scripts/db.sh seed",
    "test:pg": "bash scripts/test-pg.sh",
    "db:limpar-testes": "bash scripts/db.sh limpar-testes",
    "dev:full": "bash scripts/dev.sh",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "build:imagem": "docker build -f server/Dockerfile -t metricas-dspd-server .",
    "openapi:gerar": "pnpm --filter @metricas-dspd/server run openapi:gerar",
    "homolog:subir": "node tools/homolog/src/main.ts subir",
    "homolog:derrubar": "node tools/homolog/src/main.ts derrubar",
    "homolog:smoke": "node tools/homolog/src/main.ts smoke",
    "homolog:migracao": "node tools/homolog/src/main.ts migracao"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.6"
}
