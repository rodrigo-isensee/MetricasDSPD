{
  "name": "metricas-dspd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @metricas-dspd/web",
    "build": "npm run build -w @metricas-dspd/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @metricas-dspd/contratos -w @metricas-dspd/metricas -w @metricas-dspd/mock -w @metricas-dspd/web",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write web packages eslint.config.js tsconfig.base.json package.json",
    "format:check": "prettier --check web packages eslint.config.js tsconfig.base.json package.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "pronto": "npm run lint && npm run format:check && npm run pronto --workspaces --if-present",
    "e2e": "npm test -w @metricas-dspd/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
