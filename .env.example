# Copie para .env (nunca versionado). Valores abaixo são só para desenvolvimento local (Docker Compose).
PG_PORT=5432
POSTGRES_PASSWORD=troque-me-postgres
DSPD_PWD_MIGRADOR=migrador_dev
DSPD_PWD_COLETOR=coletor_dev
DSPD_PWD_API=api_dev
DSPD_PWD_REF=ref_dev
DSPD_PWD_WEBHOOK=webhook_dev
DSPD_PWD_AUTOMACAO=automacao_dev
# Usadas por db:migrate e db:seed (mantenha as senhas iguais às de cima)
PG_MIGRADOR_URL=postgres://dspd_migrador:migrador_dev@127.0.0.1:5432/metricas
# Usadas por pnpm dev (api e worker fora do contêiner); no Compose são montadas pelo próprio docker-compose.yml
PG_API_URL=postgres://dspd_api:api_dev@127.0.0.1:5432/metricas
PG_COLETOR_URL=postgres://dspd_coletor:coletor_dev@127.0.0.1:5432/metricas
# Papel de referência: só o comando ac:ref-sync (grava ref_dominio com vigência); nunca a api nem o worker
PG_REF_URL=postgres://dspd_ref:ref_dev@127.0.0.1:5432/metricas
# Webhook do BusinessMap (S-12): defina um segredo longo (>= 16 caracteres) para ligar POST /webhooks/businessmap.
# WEBHOOK_BM_SEGREDO=
# PG_WEBHOOK_URL=postgres://dspd_webhook:webhook_dev@127.0.0.1:5432/metricas   # só para pnpm dev (api fora do contêiner)
# LOG_LEVEL=info  API_PORT=3000  WEB_PORT=8080
# Usada pelos testes de banco (database separado; cada execução cria e remove seus próprios schemas)
PG_TESTE_URL=postgres://dspd_migrador:migrador_dev@127.0.0.1:5432/metricas_test
# DSPD_SCHEMA_PREFIXO=   # vazio fora dos testes
# MOCK_SEMENTE=1
# DADOS_FONTE=mock   # mock (padrão) ou real: só em mock as extensões das métricas complementares entram
DSPD_PWD_PESQUISA=
# Coletor do BusinessMap (pedido 052): só a máquina do dono tem valor; aqui ficam só os nomes.
# A chave é a do dono (pode alterar o quadro): nunca em log, nunca versionada.
BUSINESSMAP_URL_BASE=
BUSINESSMAP_APIKEY=
BUSINESSMAP_QUADROS_IDS=
BUSINESSMAP_LIMITE_POR_MINUTO=
BUSINESSMAP_TIMEOUT_MS=
BUSINESSMAP_PAGINA_TAMANHO=
# Coletor do Acelerato (pnpm coleta ac; pedido 056, ADR 0023): leitura só leitura da tabela MySQL, só na máquina do dono.
# Sem valor padrão (exceto os dois últimos): preencha só no .env, nunca aqui. Host, porta, banco, usuário e senha em variáveis
# separadas (nunca URL com senha). A impressão SHA-256 e o PEM do certificado do servidor são obrigatórios (TLS fixado).
# ACELERATO_MYSQL_HOST=
# ACELERATO_MYSQL_PORT=
# ACELERATO_MYSQL_DATABASE=
# ACELERATO_MYSQL_USER=
# ACELERATO_MYSQL_PASSWORD=
# ACELERATO_MYSQL_TLS_SHA256=
# ACELERATO_MYSQL_TLS_CERT_FILE=
# ACELERATO_MYSQL_MAX_EXEC_MS=120000
# ACELERATO_MYSQL_MARGEM_HORAS=24
