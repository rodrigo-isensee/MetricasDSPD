# Copie para .env (nunca versionado). Valores abaixo são só para desenvolvimento local (Docker Compose).
PG_PORT=5432
POSTGRES_PASSWORD=troque-me-postgres
DSPD_PWD_MIGRADOR=migrador_dev
DSPD_PWD_COLETOR=coletor_dev
DSPD_PWD_API=api_dev
DSPD_PWD_REF=ref_dev
DSPD_PWD_WEBHOOK=webhook_dev
DSPD_PWD_AUTOMACAO=automacao_dev
# Usadas por db:migrate e db:seed (mantenha as senhas iguais às de cima)
PG_MIGRADOR_URL=postgres://dspd_migrador:migrador_dev@127.0.0.1:5432/metricas
# Usada pelos testes de banco (database separado; cada execução cria e remove seus próprios schemas)
PG_TESTE_URL=postgres://dspd_migrador:migrador_dev@127.0.0.1:5432/metricas_test
# DSPD_SCHEMA_PREFIXO=   # vazio fora dos testes
# MOCK_SEMENTE=1
