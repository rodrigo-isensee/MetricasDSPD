[Unit]
Description=Metricas DSPD: sincronizacao semanal das referencias (dicionarios, calendario, subgrupos do Apontamento)
Wants=docker.service
After=docker.service network-online.target
OnFailure=metricas-coleta-falha@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metricas-dspd
# Sem credencial nesta unidade: o Compose entrega ao container so as senhas do banco (.env do projeto); nenhuma chama BusinessMap nem Acelerato.
EnvironmentFile=-/etc/metricas-dspd/host.env
# Em sequencia; a primeira que falhar interrompe as seguintes e dispara o aviso de falha. Todas idempotentes (arquivos versionados, papel dspd_ref).
ExecStart=/usr/bin/docker compose --profile coleta run --rm coleta src/entradas/ref-sync-businessmap.ts
ExecStart=/usr/bin/docker compose --profile coleta run --rm coleta src/entradas/ref-sync-ac.ts
ExecStart=/usr/bin/docker compose --profile coleta run --rm coleta src/entradas/ref-sync-calendario.ts
ExecStart=/usr/bin/docker compose --profile coleta run --rm coleta src/entradas/ref-sync-apontamento.ts
TimeoutStartSec=30min
