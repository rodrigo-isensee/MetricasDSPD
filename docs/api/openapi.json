    "/api/v1/filtros/{dominio}": {
      "get": {
        "summary": "Opções dos filtros de uma fonte (sem opção de pessoa)",
        "tags": [
          "referencia"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "businessmap",
                "acelerato"
              ]
            },
            "in": "path",
            "name": "dominio",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "dominio": {
                          "type": "string",
                          "enum": [
                            "businessmap"
                          ]
                        },
                        "equipes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "nome": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "id",
                              "nome"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "tipos": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "nome": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "id",
                              "nome"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "sistemas": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "nome": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "id",
                              "nome"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "historico": {
                          "type": "object",
                          "properties": {
                            "inicio": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            },
                            "fim": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            }
                          },
                          "required": [
                            "inicio",
                            "fim"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "dominio",
                        "equipes",
                        "tipos",
                        "sistemas",
                        "historico"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "dominio": {
                          "type": "string",
                          "enum": [
                            "acelerato"
                          ]
                        },
                        "equipes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "nome": {
