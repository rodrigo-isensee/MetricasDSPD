{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "esModuleInterop": true, "types": ["node"]
  },
  "include": ["src", "migrations", "tests", "*.ts"]
}
