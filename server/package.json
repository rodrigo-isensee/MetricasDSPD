{
  "name": "@metricas-dspd/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "migrate": "tsx src/plataforma/db/cli.ts",
    "pronto": "pnpm run typecheck && pnpm run lint && pnpm run cobertura",
    "cobertura": "vitest run --coverage",
    "seed": "tsx src/plataforma/db/seed-cli.ts",
    "test:pg": "vitest run --project pg",
    "checksums": "tsx src/plataforma/db/checksums-cli.ts",
    "db:limpar-testes": "tsx src/plataforma/db/limpar-testes-cli.ts"
  },
  "dependencies": {
    "@metricas-dspd/contratos": "workspace:*",
    "@metricas-dspd/metricas": "workspace:*",
    "@metricas-dspd/mock": "workspace:*",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
